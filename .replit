modules = ["nodejs-24", "python-3.11"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

# Environment variables are stored in Replit Secrets (not committed to git).
# Go to: Replit > Tools > Secrets and add:
#   SUPABASE_URL
#   SUPABASE_ANON_KEY
#   VITE_SUPABASE_URL
#   VITE_SUPABASE_ANON_KEY
#   GEMINI_API_KEY
#   GEMINI_API_KEY_2
#   GEMINI_API_KEY_3
#   API_SECRET_KEY
