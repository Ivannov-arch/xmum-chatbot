# ============================================================
# XMUM Campus Chatbot — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git!
# ============================================================

# --- Supabase ---
# Found at: Supabase Dashboard → Settings → API
SUPABASE_URL=your-project-url-here
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- FastAPI Server ---
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-me-before-production

# --- Chatbot Config ---
CHATBOT_MAX_CONTEXT_TURNS=5
CHATBOT_LANGUAGE=en

# Gemini API Key
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_API_KEY_2=your-gemini-api-key-here
GEMINI_API_KEY_3=your-gemini-api-key-here

# --- RAG & Vector Config ---
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
RAG_MATCH_THRESHOLD=0.3
RAG_TOP_K=5
